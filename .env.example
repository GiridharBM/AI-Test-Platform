# AI Test Platform — backend overrides (M16-A configuration layer).
#
# Copy this file to `.env` or export the variables in the deployment
# environment to override backend defaults. EVERY variable is optional; with
# none set the backend uses its documented defaults. The backend does not read
# `.env` itself — a process manager / launcher must load these into the
# environment before starting `uvicorn app.main:app`.
#
# These are configuration values, not credentials; never put secrets here.

# Where ingested projects and .meta state are persisted.
# Default: <backend>/workspace
#ATP_WORKSPACE_DIR=/var/lib/ai-test-platform/workspace

# HTTP bind address for the backend (uvicorn already defaults to 127.0.0.1:8000).
#ATP_BACKEND_HOST=127.0.0.1
#ATP_BACKEND_PORT=8000

# A pipeline left `running` longer than this (seconds) without progress is
# recovered to `unavailable` (M15 persistence). Integer >= 1. Default: 1800.
#ATP_PIPELINE_STUCK_TIMEOUT_SECONDS=1800

# Docker image name used for the sandbox test-runner. Must be non-empty.
# Default: ai-test-platform-testrunner
#ATP_TESTRUNNER_IMAGE=ai-test-platform-testrunner

# --- M16-B container deployment (docker compose) -----------------------------
# Used by compose.yaml for substitution/overrides. The backend does NOT load
# .env itself; every variable is optional and the compose defaults hold when
# unset. Never put secrets here.

# Host-facing port for the containerized frontend (nginx). Default: 8080.
#ATP_FRONTEND_PORT=8080

# Numeric GID of the "docker" group ON THE DOCKER HOST. The non-root backend
# process (UID 1000) uses it to access the mounted Docker socket. Obtain it on
# Linux with:
#   getent group docker | cut -d: -f3
#   stat -c '%g' /var/run/docker.sock
# Default: 999.
#ATP_DOCKER_GID=999

# Container deployment uses an identical host<->container bind path (changing
# it requires editing the compose.yaml bind mount too). The backend ignores
# this value for the container path — compose env + bind define it.
#ATP_WORKSPACE_DIR=/var/lib/ai-test-platform/workspace

# Production container bind: 0.0.0.0 is INTERNAL-ONLY (not host-published).
#ATP_BACKEND_HOST=0.0.0.0
#ATP_BACKEND_PORT=8000

# Must match the compose `testrunner` service image.
#ATP_TESTRUNNER_IMAGE=ai-test-platform-testrunner